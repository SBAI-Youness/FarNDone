<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <!-- Top Status Pill -->
        <TextView
            android:id="@+id/tvTrackpadTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trackpad"
            android:textColor="@color/black_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_blue_outlined"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="● Fedora · 12 ms"
            android:textColor="@color/blue_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvTrackpadTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTrackpadTitle" />

        <!-- Main Rounded Trackpad Surface -->

        <!-- Circular Apps Menu Button sitting on the bottom-middle edge of the Trackpad -->

        <!-- Right-Side Vertical Scroll Bar -->
        <FrameLayout
            android:id="@+id/touchpadArea"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_trackpad_rounded"
            app:layout_constraintBottom_toTopOf="@id/layoutDockButtons"
            app:layout_constraintEnd_toStartOf="@id/scrollArea"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTrackpadTitle"
            >

            <LinearLayout
                android:id="@+id/layoutGestureHints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="trackpad"
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="5dp"
                    android:text="Drag · Move cursor\nTap · Click  |  2-Finger · Right click"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/scrollArea"
            android:layout_width="34dp"
            android:layout_height="0dp"
            android:layout_marginVertical="28dp"
            android:background="@drawable/bg_scroll_pill"
            app:layout_constraintBottom_toBottomOf="@id/touchpadArea"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/touchpadArea">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:rotation="90"
                android:text="Scroll"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Bottom 3-Icon Hardware Dock: [ < ]  [ ◇ Settings ]  [ > ] -->
        <LinearLayout
            android:id="@+id/layoutDockButtons"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Left Click (<) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLeftClick"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_dock_button"
                android:stateListAnimator="@null"
                android:text="‹"
                android:textColor="@color/black_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Center Diamond Settings Button (◇) -->

            <!-- Right Click (>) -->
            <ImageButton
                android:id="@+id/btnPcApps"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_circle_apps"
                android:contentDescription="Apps menu"
                android:elevation="4dp"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_dialog_dialer"
                app:tint="@color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRightClick"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_dock_button"
                android:stateListAnimator="@null"
                android:text="›"
                android:textColor="@color/black_primary"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/includeBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>